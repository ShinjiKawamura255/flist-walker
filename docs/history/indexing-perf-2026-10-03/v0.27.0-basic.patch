+pub(super) enum Source {
+    FileList,
+    Walker,
+}
+impl Source {
+    pub(super) fn name(self) -> &'static str {
+        match self {
+            Self::FileList => "FileList",
+            Self::Walker => "Walker",
+        }
+    }
+    pub(super) fn parse(name: &str) -> Self {
